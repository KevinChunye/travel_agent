# Copy to .env (never commit .env). All secrets live in environment variables.

# --- Core ---
# Comma-separated provider adapters to enable: mock, duffel, trainline, distribusion
TRAVEL_PROVIDERS=google_flights
DATABASE_PATH=data/travel_agent.sqlite3
DEFAULT_CURRENCY=USD
# Tolerated price drift (%) between confirmation and booking before re-asking
PRICE_BUFFER_PCT=0

# --- Duffel (bookable provider; required when TRAVEL_PROVIDERS includes duffel) ---
# Use a test-mode key (duffel_test_...) until you are ready for live bookings.
DUFFEL_API_KEY=

# --- SerpApi Google Flights (search-only live fares; free tier ~250/mo) ---
# The active provider (TRAVEL_PROVIDERS=google_flights). Search-only:
# offers carry a Google Flights booking link; no in-agent booking.
SERPAPI_API_KEY=
# Monthly quota management (hard ceiling / background-protected reserve)
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_RESERVE=25
# Equivalent searches within this window are served from cache for free
SEARCH_CACHE_TTL_MINUTES=360
# /travel dashboard port
DASHBOARD_PORT=8090

# --- WhatsApp Cloud API (only for direct-mode deployment; unused when
#     OpenClaw's own WhatsApp channel handles transport) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# --- OpenClaw / deployment ---
# API key for the LLM powering the OpenClaw agent, per your OpenClaw config.
ANTHROPIC_API_KEY=
