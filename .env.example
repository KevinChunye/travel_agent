# Copy to .env or set as deployment environment variables.
# Never commit real values; this repo is public.

# --- Active configuration ---
# Provider adapters: google_flights (live, via SerpAPI) or mock (offline dev).
# "serpapi" is accepted as a legacy alias for google_flights.
TRAVEL_PROVIDERS=google_flights
SERPAPI_API_KEY=
DATABASE_PATH=data/travel_agent.sqlite3
# Repo root the OpenClaw skill cds into before running the CLI.
TRAVEL_AGENT_HOME=

# --- SerpAPI quota management ---
SERPAPI_MONTHLY_LIMIT=250
SERPAPI_RESERVE=25
# Equivalent searches within this window are served from cache for free.
SEARCH_CACHE_TTL_MINUTES=360

# --- Dashboard ---
DASHBOARD_PORT=8090

# --- Legacy / optional (not used by the active workflow) ---
# Duffel bookable-provider adapter (dormant; kept isolated in the codebase).
DUFFEL_API_KEY=
PRICE_BUFFER_PCT=0
# Direct-mode WhatsApp Cloud API adapter (unused when OpenClaw's own
# WhatsApp channel handles transport, which is the standard deployment).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
