#!/bin/sh
# Stable entrypoint for the travel-agent CLI, safe to call from any cwd.
# Resolves the repo root (TRAVEL_AGENT_HOME wins, else this script's parent)
# and runs the command. If the command printed nothing (it died before
# answering), the persisted response file is echoed instead: it then holds
# that command's error or an "incomplete" marker, never an older result.
ROOT="${TRAVEL_AGENT_HOME:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
cd "$ROOT" || { echo "{\"ok\": false, \"error\": \"repo not found at $ROOT\"}"; exit 1; }
out=$(python3 -m src.cli "$@")
rc=$?
if [ -n "$out" ]; then
    printf '%s\n' "$out"
elif [ -f data/last_response.json ]; then
    cat data/last_response.json
fi
exit $rc
